rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && request.auth.token.email_verified == true && (email() in ["godser@gmail.com"] || exists(/databases/$(database)/documents/admins/$(email()))); }
    function isApproved() { return signedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.status == 'approved'; }
    function classTeacher(code) { return signedIn() && get(/databases/$(database)/documents/classes/$(code)).data.teacherUid == request.auth.uid; }

    match /admins/{mail} {
      allow read: if signedIn() && email() == mail;
      allow write: if false;
    }
    match /teachers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.status == 'pending' && !email().matches('.*@elev[.]mate9[.]invalid');
      allow update, delete: if isAdmin();
    }
    match /classes/{code} {
      allow get: if true;
      allow list: if signedIn() && (resource.data.teacherUid == request.auth.uid || isAdmin());
      allow create: if (isApproved() || isAdmin()) && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.teacherUid == request.auth.uid || isAdmin());

      match /students/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || classTeacher(code) || isAdmin());
        allow create, update: if signedIn() && request.auth.uid == uid
            && email().matches('.*@elev[.]mate9[.]invalid')
            && exists(/databases/$(database)/documents/classes/$(code));
        allow delete: if signedIn() && (classTeacher(code) || isAdmin());
      }
    }
    match /stats/{id} {
      allow read: if isAdmin();
      allow create: if id.matches('(d-[0-9]{4}-[0-9]{2}-[0-9]{2}|m-[0-9]{4}-[0-9]{2}|total)')
          && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if id.matches('(d-[0-9]{4}-[0-9]{2}-[0-9]{2}|m-[0-9]{4}-[0-9]{2}|total)')
          && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }
    match /students/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid && email().matches('.*@elev[.]mate9[.]invalid');
    }
  }
}
